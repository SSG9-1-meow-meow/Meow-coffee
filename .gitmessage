# ┌───────────────────────────────────────────────────────────────┐
# │                         Commit Message                        │
# └───────────────────────────────────────────────────────────────┘

<type>(<scope>): <subject>

# 예시:
# feat(login): 로그인 기능 추가
# fix(auth): 토큰 만료 오류 수정

# ────────────────────────────────────────────────────────────────
# ✅ type (커밋 목적)
# ────────────────────────────────────────────────────────────────
# feat     : 새로운 기능 추가
# fix      : 버그 수정
# docs     : 문서 수정
# style    : 코드 포맷팅, 세미콜론 누락 등 비기능 변경
# refactor : 코드 리팩토링 (기능 변경 없음)
# test     : 테스트 코드 추가 또는 수정
# chore    : 기타 변경사항 (예: 패키지 업데이트)
# build    : 빌드 관련 파일 수정
# ci       : CI 설정 관련 변경
# perf     : 성능 개선
# revert   : 이전 커밋 되돌리기

# ────────────────────────────────────────────────────────────────
# ✅ scope (선택 사항)
# ────────────────────────────────────────────────────────────────
# 변경된 기능, 모듈, 컴포넌트 이름을 명시
# 예: auth, login, user-profile 등

# ────────────────────────────────────────────────────────────────
# ✅ subject (요약 설명)
# ────────────────────────────────────────────────────────────────
# - 간결하고 명확하게 작성 (50자 이내 권장)
# - 첫 글자는 소문자, 마침표는 생략
# - 변경의 핵심을 설명

# ────────────────────────────────────────────────────────────────
# ✅ body (선택 사항)
# ────────────────────────────────────────────────────────────────
# 변경한 이유, 상세 설명 등을 작성
# 여러 줄 가능하며 한 줄 띄워서 작성

# ────────────────────────────────────────────────────────────────
# ✅ BREAKING CHANGE (선택 사항)
# ────────────────────────────────────────────────────────────────
# 호환성 깨지는 변경이 있을 경우 명시
# 예: BREAKING CHANGE: 로그인 방식이 OAuth로 변경됨

# ────────────────────────────────────────────────────────────────
# 커밋 메시지는 위 형식을 따라 작성해주세요!
# 주석(#)은 실제 커밋에 포함되지 않습니다.
