<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssg.meowcoffee.mapper.FinanceMapper">

    <resultMap id="ExpenseMap" type="com.ssg.meowcoffee.domain.ExpenseVO">
        <id property="expenseId" column="expenseId"/>
        <result property="expenseDt" column="expenseDt"/>
        <result property="expenseCategory" column="expenseCategory"/>
        <result property="totalAmt" column="totalAmt"/>
        <result property="expenseStatus" column="expenseStatus"/>
        <result property="confirmDt" column="confirmDt"/>
        <result property="isDelete" column="isDelete"/>
        <result property="whId" column="whId"/>
        <result property="userId" column="userId"/>
    </resultMap>

    <resultMap id="InvoiceMap" type="com.ssg.meowcoffee.domain.InvoiceVO">
        <id property="invoiceId" column="invoiceId"/>
        <result property="invoiceDt" column="invoiceDt"/>
        <result property="totalAmt" column="totalAmt"/>
        <result property="invoiceStatus" column="invoiceStatus"/>
        <result property="depositDt" column="depositDt"/>
        <result property="userId" column="userId"/>
    </resultMap>

    <resultMap id="RevenueMap" type="com.ssg.meowcoffee.domain.RevenueVO">
        <id property="revenueId" column="revenueId"/>
        <result property="totalAmt" column="totalAmt"/>
        <result property="revenueDt" column="revenueDt"/>
        <result property="whId" column="whId"/>
        <result property="userId" column="userId"/>
    </resultMap>

    <!-- ===== Expense: 조회 ===== -->
    <!--지출내역 전체 조회-->
    <select id="selectExpenses" resultMap="ExpenseMap">
        SELECT *
        FROM expense
        WHERE isDelete = false
        ORDER BY expenseDt DESC, expenseId DESC
    </select>

    <!--지출내역 창고별 조회-->
    <select id="selectExpensesByWhId" parameterType="long" resultMap="ExpenseMap">
        SELECT *
        FROM expense
        WHERE isDelete = false
          AND whId = #{whId}
        ORDER BY expenseDt DESC, expenseId DESC
    </select>

    <!--지출내역 카테고리별 조회-->
    <select id="selectExpensesByCategory" parameterType="string" resultMap="ExpenseMap">
        SELECT *
        FROM expense
        WHERE isDelete = false
          AND expenseCategory = #{expenseCategory}
        ORDER BY expenseDt DESC, expenseId DESC
    </select>

    <!--지출내역 거래처별 조회-->
    <select id="selectExpensesByUserId" parameterType="string" resultMap="ExpenseMap">
        SELECT *
        FROM expense
        WHERE isDelete = false
          AND userId = #{userId}
        ORDER BY expenseDt DESC, expenseId DESC
    </select>

    <!-- ===== Expense: 생성 (카테고리 고정: management) ===== -->
    <insert id="insertExpense" parameterType="com.ssg.meowcoffee.dto.ExpenseInputDTO" useGeneratedKeys="true"
            keyProperty="expenseId" keyColumn="expenseId">
        INSERT INTO expense
            (expenseDt, expenseCategory, totalAmt, expenseStatus, whId)
        VALUES (CURDATE(), 'management', #{totalAmt}, 'draft', #{whId})
    </insert>

    <!-- ===== Expense: 수정 ===== -->
    <!--expense Update-->
    <update id="updateExpense" parameterType="com.ssg.meowcoffee.dto.ExpenseUpdateDTO">
        UPDATE expense
        SET totalAmt = #{totalAmt}
        WHERE expenseId = #{expenseId}
    </update>

    <!--'posted' 변경-->
    <update id="updateExpensePosted">
        UPDATE expense
        SET confirmDt     = CURDATE(),
            expenseStatus = 'posted'
        WHERE expenseId = #{expenseId}
    </update>

    <!-- soft delete -->
    <update id="updateExpenseDeleted">
        UPDATE expense
        SET isDelete = true
        WHERE expenseId = #{expenseId}
    </update>

    <!-- ===== Invoice: 조회 ===== -->
    <!--청구내역 전체 조회-->
    <select id="selectInvoices" resultMap="InvoiceMap">
        SELECT *
        FROM invoice
        ORDER BY invoiceDt DESC, invoiceId DESC
    </select>

    <!--청구내역 거래처별 조회-->
    <select id="selectInvoicesByUserId" parameterType="string" resultMap="InvoiceMap">
        SELECT *
        FROM invoice
        WHERE userId = #{userId}
        ORDER BY invoiceDt DESC, invoiceId DESC
    </select>

    <!--청구내역 상태별 조회-->
    <select id="selectInvoicesByStatus" parameterType="string" resultMap="InvoiceMap">
        SELECT *
        FROM invoice
        WHERE invoiceStatus = #{invoiceStatus}
        ORDER BY invoiceDt DESC, invoiceId DESC
    </select>

    <!-- ===== Invoice: 수정 ===== -->
    <update id="updateInvoiceStatus"
            parameterType="com.ssg.meowcoffee.dto.InvoiceUpdateDTO">
        UPDATE invoice
        SET invoiceStatus = #{invoiceStatus}
        <if test="invoiceStatus == 'paid'">
            , depositDt = CURDATE()
        </if>
        WHERE invoiceId = #{invoiceId}
    </update>

    <!-- ===== Revenue: 조회 ===== -->
    <select id="selectRevenues" resultMap="RevenueMap">
        SELECT *
        FROM revenue
        ORDER BY revenueDt DESC, revenueId DESC
    </select>


    <!-- 창고 테이블에서 목록 조회 (있으면 우선 사용) -->
    <select id="selectWarehouses" resultType="hashmap">
        SELECT whId, whName
        FROM warehouse
        ORDER BY whName
    </select>

</mapper>